# ==============================================================================
# UyTop Uzbekistan Production Environment Configuration Template (.env.production)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME (SERVER-ONLY)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
ALLOWED_ORIGINS=https://uytop.uz,https://www.uytop.uz,https://staging.uytop.uz
ENABLE_SWAGGER=false

# ------------------------------------------------------------------------------
# 2. POSTGRESQL 16 DATABASE (SERVER-ONLY)
# ------------------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_USER=uytop_prod_user
DB_PASSWORD=CHANGE_TO_STRONG_GENERATED_32_CHAR_PASSWORD
DB_NAME=uytop_prod_db
DB_POOL_MAX=30

# ------------------------------------------------------------------------------
# 3. REDIS 7 CACHE & RATE LIMITER (SERVER-ONLY)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_TO_STRONG_REDIS_AUTH_PASSWORD

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION (SERVER-ONLY)
# ------------------------------------------------------------------------------
JWT_SECRET=GENERATE_64_CHAR_HEX_SECRET_openssl_rand_hex_32
JWT_EXPIRES_IN=15m

# ------------------------------------------------------------------------------
# 5. S3 / CLOUD OBJECT STORAGE FOR PROPERTY PHOTOS (SERVER-ONLY)
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_BUCKET=uytop-production-media
S3_ACCESS_KEY=YOUR_PRODUCTION_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_PRODUCTION_S3_SECRET_KEY
S3_REGION=eu-central-1
MAX_IMAGE_SIZE_MB=10

# ------------------------------------------------------------------------------
# 6. AI PROVIDER CONFIGURATION (SERVER-ONLY)
# ------------------------------------------------------------------------------
AI_PROVIDER=openai
AI_API_KEY=YOUR_PRODUCTION_AI_API_KEY
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=6000

# ------------------------------------------------------------------------------
# 7. CLIENT-FACING CONFIGURATION (PUBLIC — ACCESSIBLE IN BROWSER)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://uytop.uz
NEXT_PUBLIC_YANDEX_MAP_KEY=f3306db0-3796-48a0-8a47-f7037f6a73c1
NEXT_PUBLIC_API_URL=https://uytop.uz/api/v1
API_INTERNAL_URL=http://api:4000/api/v1
