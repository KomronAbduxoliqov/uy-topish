# Environment Configuration for UyTop (Production & Local)
NODE_ENV=development
PORT=4000

# PostgreSQL 16 Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
DB_NAME=uytop_db

# In-Memory Cache & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & JWT
JWT_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
JWT_EXPIRES_IN=15m

# Next.js Client-Facing Configuration
NEXT_PUBLIC_SITE_URL=https://uytop.uz
NEXT_PUBLIC_YANDEX_MAP_KEY=f3306db0-3796-48a0-8a47-f7037f6a73c1
API_INTERNAL_URL=http://localhost:4000/api/v1
